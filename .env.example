PORT=8787
CONFIG_PATH=./config.json
# iron-session 加密 Cookie，至少 32 位随机串（生产环境务必更换）
SESSION_SECRET=请替换为至少32位随机字符串_abcdefghijklmnop
# 可选：管理密码仅通过环境变量提供（config.json 可省略 adminPassword）
# ADMIN_PASSWORD=
# 登录限速：每 IP 在时间窗内最多尝试次数（默认 5 次 / 60 秒）
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW_MS=60000
# 单源 HTTP 响应体最大字节数（默认 20_000_000）
# MAX_SOURCE_BYTES=20000000
# 对外可访问的 /sub 基址（反向代理、Docker 内网 Host 与公网不一致时，修正 Clash proxy-providers 内 URL）
# 示例：https://proxy.example.com/sub 或 https://proxy.example.com（会自动补 /sub）
# PUBLIC_SUB_BASE_URL=
# Clash rule-providers 远程规则源（默认 ACL4SSR jsDelivr；本仓库自定义规则见 REPO_RULES_BASE_URL）
# ACL4SSR_RULES_BASE_URL=https://cdn.jsdelivr.net/gh/ACL4SSR/ACL4SSR@master
# REPO_RULES_BASE_URL=https://cdn.jsdelivr.net/gh/hurryhuang1007/proxy-subscribe-merge@main
